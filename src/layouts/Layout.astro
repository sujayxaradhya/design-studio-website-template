---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const favicon = "data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2064%2064'%3E%3Crect%20width%3D'64'%20height%3D'64'%20rx%3D'14'%20fill%3D'%236c3cff'%2F%3E%3Ctext%20x%3D'32'%20y%3D'45'%20font-family%3D'Arial%2CHelvetica%2Csans-serif'%20font-size%3D'38'%20font-weight%3D'700'%20text-anchor%3D'middle'%20fill%3D'%23ffffff'%3EO%3C%2Ftext%3E%3C%2Fsvg%3E";
---
<!doctype html>
<!--
  Free website template by 8B: https://8b.com/templates/onda/
  Source: https://github.com/8bsite/design-studio-website-template
  MIT License (code) https://8b.com/ · Photos: Unsplash License, see CREDITS.md · Fonts: Google Fonts (OFL)
  Astro site: one page, one component per section. Notes for people and AI agents: README.md and AGENTS.md.
  Scroll motion: CSS scroll-driven animations and a small motion kit, no libraries.
-->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="generator" content="8B Templates">
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content="https://your-domain.example/preview.png" data-8b-placeholder="og-image">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href={favicon} data-8b-placeholder="favicon">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" href="https://fonts.gstatic.com/s/gabarito/v9/QGYtz_0dZAGKJJ4t3HtoW4U.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="https://fonts.gstatic.com/s/onest/v11/gNMKW3F-SZuj7xmf-HY.woff2" as="font" type="font/woff2" crossorigin>
<script is:inline data-8b-part="motion-gate">
if (matchMedia('(prefers-reduced-motion: no-preference)').matches && CSS.supports('animation-timeline: view()')) document.documentElement.setAttribute('data-8b-live', '');
</script>
</head>
<body class="m-text">
<a class="skip" href="#main">Skip to content</a>
<slot />
<script>
import '../scripts/motion-kit.js';
</script>
</body>
</html>
