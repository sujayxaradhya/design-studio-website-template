---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Work from '../components/Work.astro';
import Again from '../components/Again.astro';
import Capabilities from '../components/Capabilities.astro';
import Method from '../components/Method.astro';
import Studio from '../components/Studio.astro';
import Journal from '../components/Journal.astro';
import Faq from '../components/Faq.astro';
