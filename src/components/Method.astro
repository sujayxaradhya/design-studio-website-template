---
// Four steps for the four ring stations (top, right, bottom, left).
const steps = [
  { title: 'Listen', text: 'Two weeks with your customers, your data and your front line before we draw anything at all.' },
  { title: 'Make', text: 'Small mixed teams ship real, testable things early: in days, not quarters, and in front of real people.' },
  { title: 'Measure', text: 'We agree on what better looks like before we start, then report it honestly, good news or not.' },
  { title: 'Again', text: 'We take what we learned and go round once more. It is not the end of the project. It is the job.' },
];
const stations = [[0, -1], [1, 0], [0, 1], [-1, 0]];
---
<!-- method: process: four steps beside a ring the scroll draws round (demo: Listen, Make, Measure, Again) (animation: scene:method) -->
<section id="method" data-8b-section="method" aria-labelledby="method-title">
  <div class="method__head">
    <h2 class="m-text-3" id="method-title" data-8b-motion="rise">How we work<span class="m-dot" aria-hidden="true"></span></h2>
    <p class="m-text-5 method__lead" data-8b-motion="ink">Every project runs the same loop of four steps. The fourth is the one most studios skip, and it is where the best work happens.</p>
  </div>
  <div class="method__body">
    <div class="method__ring" aria-hidden="true">
      <svg class="method__svg" viewBox="0 0 400 400"><circle class="method__track" cx="200" cy="200" r="170"/><circle class="method__arc" cx="200" cy="200" r="170" pathLength="1" stroke-dasharray="1 1" stroke-dashoffset="0"/></svg>
      {stations.map(([x, y]) => <span class="method__station" style={`--x:${x};--y:${y}`}></span>)}
      <span class="method__arm"><span class="method__runner"></span></span>
    </div>
    <ol class="method__steps">
      {steps.map(step => <li class="step"><h3 class="m-text-4">{step.title}</h3><p class="m-text-5 step__text">{step.text}</p></li>)}
    </ol>
  </div>
</section>

<style is:global>
@layer sections {
#method { position: relative; padding: var(--space-2) var(--space-1); background: var(--color-2); }
#method .method__head { display: grid; gap: 24px; max-width: 60rem; margin-bottom: clamp(48px, 9vh, 110px); }
#method .method__lead { max-width: 34rem; }
#method .method__body { display: grid; grid-template-columns: minmax(0, 1fr) 92px; gap: 20px; align-items: start; }
#method .method__ring { position: relative; grid-column: 2; grid-row: 1; width: 100%; aspect-ratio: 1; }
#method .method__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; rotate: -90deg; }
#method .method__track { fill: none; stroke: color-mix(in srgb, var(--color-1) 14%, transparent); stroke-width: 1.5; }
#method .method__arc { fill: none; stroke: var(--color-3); stroke-width: 5; stroke-linecap: round; }
#method .method__station { position: absolute; left: calc(50% + 42.5% * var(--x)); top: calc(50% + 42.5% * var(--y)); width: 9%; height: 9%; margin: -4.5% 0 0 -4.5%; border-radius: var(--radius-2); background: var(--color-3); }
#method .method__arm { position: absolute; inset: 7.5%; }
#method .method__runner { position: absolute; left: 50%; top: 0; width: 15%; height: 15%; margin: -7.5% 0 0 -7.5%; border: 3px solid var(--color-3); border-radius: var(--radius-2); background: var(--color-2); }
#method .method__steps { grid-column: 1; grid-row: 1; display: grid; gap: clamp(56px, 18vh, 170px); }
#method .step { display: grid; gap: 14px; max-width: 34rem; }
#method .step__text { color: var(--color-6); }
@media (min-width: 900px) {
  #method .method__body { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 7vw; }
  #method .method__ring { grid-column: 1; width: min(100%, 50svh); justify-self: center; }
  #method .method__steps { grid-column: 2; padding-block: 8svh 14svh; }
}
}
@layer scenes {
@media (prefers-reduced-motion: no-preference) {
  #method.is-cycle .method__ring { position: sticky; top: 104px; }
  @media (min-width: 900px) { #method.is-cycle .method__ring { top: calc(50svh - min(25svh, 21vw)); } }
}
}
</style>

<script>
import { gsap, scene } from '../scripts/motion.js';

// The ring draws round with the scroll; each step lights up as the runner reaches its station.
scene('method', () => {
  const method = document.getElementById('method')!;
  const steps = [...method.querySelectorAll('.step')];
  const stations = [...method.querySelectorAll('.method__station')];
  method.classList.add('is-cycle');
  const timeline = gsap.timeline({ defaults: { ease: 'none' }, scrollTrigger: { trigger: method.querySelector('.method__steps'), start: 'top 62%', end: 'bottom 62%', scrub: true } })
    .fromTo(method.querySelector('.method__arc'), { attr: { 'stroke-dashoffset': 1 } }, { attr: { 'stroke-dashoffset': 0 }, duration: 1 }, 0)
    .fromTo(method.querySelector('.method__arm'), { rotation: 0 }, { rotation: 360, duration: 1 }, 0);
  steps.forEach((step, index) => {
    const at = index / steps.length;
    timeline.fromTo(step, { opacity: 0.2 }, { opacity: 1, duration: 0.07 }, Math.max(0, at - 0.03));
    if (stations[index]) timeline.fromTo(stations[index], { scale: 0.4 }, { scale: 1.35, duration: 0.05, ease: 'back.out(3)' }, at).to(stations[index], { scale: 1, duration: 0.08 }, at + 0.06);
  });
  return () => method.classList.remove('is-cycle');
});
</script>
