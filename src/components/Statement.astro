---
import ArrowLink from './ArrowLink.astro';

const index = [
  { href: '#work', label: 'See the work' },
  { href: '#capabilities', label: 'What we do' },
  { href: '#method', label: 'How we work' },
  { href: '#studio', label: 'Inside the studio' },
  { href: '#journal', label: 'Ideas and news' },
  { href: '#contact', label: 'Start a project' },
];
---
<!-- statement: two-line statement of what the studio does, a lead paragraph and an index of links into the page (animation: scene:statement) -->
<section id="statement" data-8b-section="statement" aria-labelledby="statement-title">
  <h2 class="m-text-3 statement__title" id="statement-title"><span class="statement__line">We make the things</span><span class="statement__line">people come back&nbsp;to<span class="m-dot statement__dot" aria-hidden="true"></span></span></h2>
  <div class="statement__body">
    <p class="m-text-5 statement__lead" data-8b-motion="ink">Launching is easy. Being chosen again on an ordinary Tuesday is the hard part, whether you run a bank, a bakery or a museum. It takes strategy, craft, engineering and a lot of listening, and it is the only kind of work we do.</p>
    <nav class="statement__index" aria-label="On this page">
      <ul>
        {index.map(link => <li><ArrowLink {...link} /></li>)}
      </ul>
    </nav>
  </div>
</section>

<style is:global>
@layer sections {
#statement { position: relative; padding: var(--space-2) var(--space-1) calc(var(--space-2) * 0.9); background: var(--color-2); }
#statement .statement__title { font-size: clamp(40px, 8.7vw, 140px); }
#statement .statement__line { display: block; }
#statement .statement__body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 48px; margin-top: clamp(56px, 11vh, 120px); }
#statement .statement__lead { max-width: 36rem; }
#statement .statement__index ul { display: grid; gap: 12px; }
@media (min-width: 900px) {
  #statement .statement__body { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); align-items: start; }
  #statement .statement__lead { font-size: clamp(24px, 2.35vw, 34px); line-height: 1.16; letter-spacing: -0.025em; }
}
}
</style>

<script>
import { adjacent, gsap, scene } from '../scripts/motion.js';

// The two lines slide in from the hero's hand-off, then the index links arrive in turn.
scene('statement', () => {
  const statement = document.getElementById('statement')!;
  if (adjacent('hero', 'statement')) {
    gsap.timeline({ defaults: { ease: 'none' }, scrollTrigger: { trigger: statement, start: 'top bottom', end: 'top 30%', scrub: true } })
      .fromTo(statement.querySelectorAll('.statement__line'), { yPercent: 85, xPercent: index => (index ? 9 : -6) }, { yPercent: 0, xPercent: 0, duration: 0.8, stagger: 0.12, ease: 'power2.out' }, 0)
      .fromTo(statement.querySelector('.statement__dot'), { scale: 0 }, { scale: 1, duration: 0.1 }, 0.9);
  }
  gsap.from(statement.querySelectorAll('.statement__index li'), { yPercent: 70, opacity: 0, duration: 0.8, stagger: 0.07, ease: 'expo.out', scrollTrigger: { trigger: statement.querySelector('.statement__index'), start: 'top 85%', once: true } });
});
</script>
