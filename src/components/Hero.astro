---
import ArrowLink from './ArrowLink.astro';
---
<!-- hero: first screen: a one-word greeting whose full stop is a giant round photo (demo: "Hello") (animation: scene:hero) -->
<section id="hero" data-8b-section="hero" aria-labelledby="hero-title">
  <div class="hero__intro">
    <p class="m-text-5 hero__lead">We're Onda, an independent brand, product and AI studio. We make things people come back to, and we'd love to hear what you're making.</p>
    <ArrowLink class="hero__link" href="#work" label="See the work" />
  </div>
  <h1 class="m-text-2 hero__title" id="hero-title" style="--len:5"><span class="hero__word"><span class="hero__mask"><span class="hero__glyphs">Hello</span></span></span><span class="hero__period" aria-hidden="true"><span class="hero__stage"><span class="hero__orbit"><span class="hero__moon"></span></span><span class="hero__aperture"><img class="hero__img" src="https://images.unsplash.com/photo-1754738381783-f9a2847bfef2?ixid=M3w0Mzc5fDB8MXxzZWFyY2h8MXx8cHVycGxlJTIwYWJzdHJhY3QlMjAzZCUyMHNoYXBlfGVufDF8Mnx8fDE3OTEyMDk2Mjd8MA&ixlib=rb-4.1.0&auto=format&fit=crop&w=470&h=470&q=60" width="1200" height="1200" alt="" fetchpriority="high"><span class="hero__tint"></span></span></span></span></h1>
</section>

<style is:global>
@layer sections {
#hero { --ap: min(74vw, 44svh); position: relative; z-index: 3; display: grid; grid-template-rows: 1fr auto; min-height: max(100svh, 560px); padding: 0 var(--space-1); background: var(--color-1); color: var(--color-2); overflow: clip visible; }
#hero .hero__intro { display: grid; justify-items: start; align-content: start; gap: 18px; max-width: 32rem; padding-top: clamp(92px, 14svh, 150px); }
#hero .hero__lead { color: var(--color-2); }
#hero .hero__title { position: static; align-self: end; padding-bottom: clamp(18px, 5svh, 52px); white-space: nowrap; }
#hero .hero__word, #hero .hero__mask, #hero .hero__glyphs { display: inline-block; }
#hero .hero__period { position: static; display: inline-block; width: 0.19em; height: 0.19em; margin-left: 0.035em; border-radius: var(--radius-2); background: var(--color-3); vertical-align: baseline; }
#hero .hero__stage { position: absolute; left: calc(50% - var(--ap) / 2); top: calc(57% - var(--ap) / 2); width: var(--ap); height: var(--ap); font-size: 16px; line-height: 0; }
#hero .hero__aperture { position: absolute; inset: 0; display: block; overflow: hidden; border-radius: var(--radius-2); background: var(--color-3); }
#hero .hero__img { width: 100%; height: 100%; object-fit: cover; }
#hero .hero__tint { position: absolute; inset: 0; background: var(--color-3); opacity: 0; }
#hero .hero__orbit { position: absolute; inset: -9%; display: block; border-radius: var(--radius-2); border: 1px solid color-mix(in srgb, var(--color-2) 16%, transparent); }
#hero .hero__moon { position: absolute; left: 50%; top: 0; width: 9%; height: 9%; margin: -4.5% 0 0 -4.5%; border-radius: var(--radius-2); background: var(--color-3); }
@media (min-width: 900px) and (orientation: landscape) {
  #hero { --ap: min(36vw, 60svh); }
  #hero .hero__title { font-size: min(26.5vw, 43svh); }
  #hero .hero__period { position: relative; background: transparent; }
  #hero .hero__stage { left: 0; top: auto; bottom: 0; }
}
@media (prefers-reduced-motion: no-preference) {
  #hero .hero__mask { animation: hero-mask .95s linear backwards; }
  #hero .hero__glyphs { animation: hero-rise .95s cubic-bezier(.16, .84, .24, 1) backwards; }
  #hero .hero__stage { transform-origin: 50% 50%; animation: hero-swell 1.1s cubic-bezier(.2, .9, .25, 1.12) backwards; }
  #hero .hero__intro { animation: hero-lift .9s .12s cubic-bezier(.16, .84, .24, 1) backwards; }
  #hero .hero__img { animation: hero-turn 46s linear infinite; }
  #hero .hero__orbit { animation: hero-orbit 13s linear infinite; }
  #hero.is-offscreen .hero__img, #hero.is-offscreen .hero__orbit { animation-play-state: paused; }
  @media (min-width: 900px) and (orientation: landscape) { #hero .hero__stage { transform-origin: 0 100%; animation-name: hero-inflate; } }
  @keyframes hero-mask { from, to { clip-path: inset(-40% -8% 0 -8%); } }
  @keyframes hero-rise { from { transform: translateY(92%); } }
  @keyframes hero-swell { from { transform: scale(.72); } }
  @keyframes hero-inflate { from { transform: scale(.36); } }
  @keyframes hero-lift { from { transform: translateY(26px); } }
  @keyframes hero-turn { to { transform: rotate(360deg); } }
  @keyframes hero-orbit { to { transform: rotate(360deg); } }
}
}
</style>

<script>
import { adjacent, box, gsap, scene, watchOffscreen } from '../scripts/motion.js';

const hero = document.getElementById('hero')!;
watchOffscreen(hero);

// The round photo travels into the statement heading's dot.
scene('hero', () => {
  if (!adjacent('hero', 'statement')) return;
  const aperture = hero.querySelector('.hero__aperture')!;
  const target = document.querySelector('#statement .statement__dot')!;
  const geometry = () => {
    const from = box(aperture), to = box(target);
    return { x: to.cx - from.cx, y: to.cy - from.cy, scale: to.w / from.w };
  };
  gsap.timeline({ defaults: { ease: 'none' }, scrollTrigger: { trigger: hero, start: 'bottom bottom', end: 'bottom 30%', scrub: true, invalidateOnRefresh: true } })
    .to(aperture, { x: () => geometry().x, y: () => geometry().y, ease: 'power1.inOut', duration: 1 }, 0)
    .to(aperture, { scale: () => geometry().scale, ease: 'power3.in', duration: 1 }, 0)
    .to(hero.querySelector('.hero__tint'), { opacity: 1, ease: 'power2.in', duration: 0.6 }, 0.4)
    .to(hero.querySelector('.hero__orbit'), { opacity: 0, duration: 0.3 }, 0)
    .to(hero.querySelector('.hero__word'), { xPercent: () => (matchMedia('(min-width: 900px) and (orientation: landscape)').matches ? -14 : 0), ease: 'power1.in', duration: 1 }, 0)
    .to(hero.querySelector('.hero__intro'), { y: -70, ease: 'power1.in', duration: 1 }, 0);
});
</script>
