---
// Four stories, each with its frame photo; scene:journal counts them with :nth-of-type rules.
const stories = [
  { kind: 'Event', date: '2026-10-01', read: 2, title: 'Open Studio Night returns to Lisbon on 14 November', text: 'Talks, half-built prototypes and a long table in the old print hall. Bring a friend who makes things.', alt: 'A speaker on a stage addressing a large audience in a dim hall', src: 'https://images.unsplash.com/photo-1769755409781-9e8924c57362?ixid=M3w0Mzc5fDB8MXxzZWFyY2h8NXx8Y29uZmVyZW5jZSUyMHN0YWdlJTIwYXVkaWVuY2UlMjBsaWdodHN8ZW58MXwwfHx8MTc5MTIwOTc3M3ww&ixlib=rb-4.1.0&auto=format&fit=crop&w=570&h=713&q=60' },
  { kind: 'Essay', date: '2026-09-18', read: 6, title: 'The second visit: why we design for the return, not the launch', text: 'Most products are judged on day one and lost on day thirty. Notes on designing for the ordinary Tuesday.', alt: 'A smiling woman working on a laptop at a bright desk', src: 'https://images.unsplash.com/photo-1783094269325-4ba186e8e01b?ixid=M3w0Mzc5fDB8MXxzZWFyY2h8Nnx8c2VydmljZSUyMGRlc2slMjBjdXN0b21lciUyMHNtaWxpbmd8ZW58MXwwfHx8MTc5MTIwOTc3NXww&ixlib=rb-4.1.0&auto=format&fit=crop&w=570&h=713&q=60' },
  { kind: 'Notes', date: '2026-08-30', read: 8, title: 'Type, tested: a variable identity that holds up at twelve pixels', text: 'How one variable family carried a bank from a forty-metre billboard to its banking app.', alt: 'Bold yellow and blue type printed on a box', src: 'https://images.unsplash.com/photo-1581080247486-57989c1f14ab?ixid=M3w0Mzc5fDB8MXxzZWFyY2h8NXx8cHJpbnRlZCUyMG1hZ2F6aW5lJTIwcGFnZXMlMjB0eXBvZ3JhcGh5fGVufDF8MHx8fDE3OTEyMDk3NzR8MA&ixlib=rb-4.1.0&auto=format&fit=crop&w=570&h=713&q=60' },
  { kind: 'Research', date: '2026-08-04', read: 5, title: 'What three hundred nurses told us about the night shift', text: 'Six weeks of field research for a health partner, and the three things we changed because of it.', alt: 'Handwritten sticky notes pinned to a corkboard after a research session', src: 'https://images.unsplash.com/photo-1542626991-cbc4e32524cc?ixid=M3w0Mzc5fDB8MXxzZWFyY2h8Mnx8d29ya3Nob3AlMjBzdGlja3klMjBub3RlcyUyMHdhbGx8ZW58MXwwfHx8MTc5MTIwOTc1MHww&ixlib=rb-4.1.0&auto=format&fit=crop&w=570&h=713&q=60' },
];
const longDate = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<!-- journal: news and articles: four stories beside a sticky photo frame (animation: scene:journal) -->
<section id="journal" data-8b-section="journal" aria-labelledby="journal-title">
  <div class="journal__head">
    <h2 class="m-text-3" id="journal-title" data-8b-motion="rise">Ideas and news<span class="m-dot" aria-hidden="true"></span></h2>
  </div>
  <div class="journal__body">
    <div class="journal__frame">
      {stories.map(story => <img class="journal__shot" src={story.src} width="1000" height="1250" alt={story.alt} loading="lazy">)}
    </div>
    <ol class="journal__list">
      {stories.map(story => <li class="story"><p class="m-text-6 story__meta"><span>{story.kind}</span> · <time datetime={story.date}>{longDate(story.date)}</time> · {story.read} min read</p><h3 class="m-text-7">{story.title}</h3><p class="m-text story__text">{story.text}</p></li>)}
    </ol>
  </div>
</section>

<style is:global>
@layer sections {
#journal { position: relative; padding: calc(var(--space-2) * 0.6) var(--space-1) var(--space-2); background: var(--color-2); }
#journal .journal__head { margin-bottom: clamp(40px, 7vh, 88px); }
#journal .journal__body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; align-items: start; }
#journal .journal__frame { position: relative; overflow: hidden; border-radius: var(--radius-1); background: var(--color-4); aspect-ratio: 16 / 10; }
#journal .journal__shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
#journal .journal__shot:first-child { z-index: 1; }
#journal .journal__list { display: grid; gap: clamp(36px, 8vh, 72px); }
#journal .story { display: grid; gap: 12px; max-width: 36rem; padding-top: 20px; border-top: 1px solid color-mix(in srgb, var(--color-1) 16%, transparent); }
#journal .story__meta { color: var(--color-6); }
#journal .story__meta span { color: var(--color-3); }
#journal .story__text { color: var(--color-6); }
@media (min-width: 900px) {
  #journal .journal__body { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 7vw; }
  #journal .journal__frame { aspect-ratio: 4 / 5; }
  #journal .journal__list { gap: clamp(64px, 18vh, 170px); padding-block: 6svh 10svh; }
}
}
@layer scenes {
@media (prefers-reduced-motion: no-preference) {
  #journal.is-swap .journal__frame { position: sticky; z-index: 1; top: 80px; }
  #journal.is-swap .journal__shot:first-child { z-index: auto; }
  @media (min-width: 900px) { #journal.is-swap .journal__frame { top: calc(50svh - min(30svh, 22vw)); max-height: 60svh; } }
}
}
</style>

<script>
import { gsap, scene } from '../scripts/motion.js';

// Each story brightens as it reaches the middle, and its photo opens over the last in the sticky frame.
scene('journal', () => {
  const journal = document.getElementById('journal')!;
  const shots = [...journal.querySelectorAll('.journal__shot')];
  journal.classList.add('is-swap');
  journal.querySelectorAll('.story').forEach((story, index) => {
    const timeline = gsap.timeline({ defaults: { ease: 'none' }, scrollTrigger: { trigger: story, start: 'top 84%', end: 'top 50%', scrub: true } })
      .fromTo(story, { opacity: 0.25 }, { opacity: 1, duration: 0.8 }, 0);
    if (index && shots[index]) timeline.fromTo(shots[index], { clipPath: 'circle(0% at 50% 50%)' }, { clipPath: 'circle(75% at 50% 50%)', ease: 'power1.inOut', duration: 1 }, 0);
  });
  return () => journal.classList.remove('is-swap');
});
</script>
