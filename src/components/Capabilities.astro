---
// Five cards: scene:capabilities stacks them with :nth-of-type rules (see AGENTS.md, Known limits).
const services = [
  { title: 'Brand and identity', line: 'Positioning, naming and identity systems with enough range to stay interesting in year five.', tags: ['Strategy', 'Naming', 'Identity systems', 'Guidelines'], alt: 'Pink and green printed boxes stacked together', src: 'https://images.unsplash.com/photo-1617825295690-28ae56c56135?ixid=M3w0Mzc5fDB8MXxzZWFyY2h8MXx8cGFja2FnaW5nJTIwZGVzaWduJTIwbW9ja3VwJTIwYm94ZXN8ZW58MXwwfHx8MTc5MTIwOTc1MHww&ixlib=rb-4.1.0&auto=format&fit=crop&w=720&h=540&q=60' },
  { title: 'Products and apps', line: 'Apps and platforms designed, engineered and measured by the same people who first sketched them.', tags: ['Product strategy', 'UX and UI', 'Engineering', 'Design systems'], alt: 'A hand holding a phone that shows a food ordering app', src: 'https://images.unsplash.com/photo-1601972599720-36938d4ecd31?ixid=M3w0Mzc5fDB8MXxzZWFyY2h8MXx8aGFuZCUyMGhvbGRpbmclMjBzbWFydHBob25lJTIwYXBwJTIwc2NyZWVufGVufDF8MXx8fDE3OTEyMDk3NzJ8MA&ixlib=rb-4.1.0&auto=format&fit=crop&w=720&h=540&q=60' },
  { title: 'Campaigns and content', line: 'Ideas sized for culture and planned like a product roadmap, so the second month is better than the first.', tags: ['Campaigns', 'Social', 'Film and photo', 'Media planning'], alt: 'A large advertisement on the side of a city building', src: 'https://images.unsplash.com/photo-1720175646447-e37d994007fc?ixid=M3w0Mzc5fDB8MXxzZWFyY2h8M3x8YmlsbGJvYXJkJTIwY2l0eSUyMHN0cmVldCUyMHBvc3RlcnxlbnwxfDF8fHwxNzkxMjA5NzUxfDA&ixlib=rb-4.1.0&auto=format&fit=crop&w=720&h=540&q=60' },
  { title: 'Service design', line: 'Every moment between a person and your company, mapped, prototyped and made a little easier.', tags: ['Research', 'Journey mapping', 'Blueprints', 'Prototyping'], alt: 'A wall of printed sticky notes from a research workshop', src: 'https://images.unsplash.com/photo-1512758017271-d7b84c2113f1?ixid=M3w0Mzc5fDB8MXxzZWFyY2h8NHx8d29ya3Nob3AlMjBzdGlja3klMjBub3RlcyUyMHdhbGx8ZW58MXwwfHx8MTc5MTIwOTc1MHww&ixlib=rb-4.1.0&auto=format&fit=crop&w=720&h=540&q=60' },
  { title: 'Applied AI', line: 'Tools your teams use on Monday morning, not a demo for the board.', tags: ['Opportunity mapping', 'Prototypes', 'Assistants', 'Team training'], alt: 'Violet light trails curving across a dark background', src: 'https://images.unsplash.com/photo-1769675353367-e581059c7c43?ixid=M3w0Mzc5fDB8MXxzZWFyY2h8M3x8YWJzdHJhY3QlMjBsaWdodCUyMHRyYWlscyUyMGRhcmslMjB2aW9sZXR8ZW58MXwwfHx8MTc5MTIwOTc3M3ww&ixlib=rb-4.1.0&auto=format&fit=crop&w=720&h=540&q=60' },
];
---
<!-- capabilities: services: five cards that stack as you scroll, each with deliverable badges and a photo (animation: scene:capabilities) -->
<section id="capabilities" data-8b-section="capabilities" aria-labelledby="capabilities-title">
  <div class="capabilities__head">
    <h2 class="m-text-3" id="capabilities-title" data-8b-motion="rise">What we do<span class="m-dot" aria-hidden="true"></span></h2>
    <p class="m-text-5 capabilities__lead">Five practices and one team in the room, from the first workshop to the last release.</p>
  </div>
  <ol class="capabilities__deck">
    {services.map(service => (
      <li class="service m-surface">
        <div class="service__text">
          <h3 class="m-text-4">{service.title}</h3>
          <p class="m-text-5 service__line">{service.line}</p>
          <ul class="service__tags">{service.tags.map(tag => <li class="m-badge">{tag}</li>)}</ul>
        </div>
        <div class="service__media" data-8b-motion="iris"><img src={service.src} width="1200" height="900" alt={service.alt} loading="lazy"></div>
        <span class="service__shade" aria-hidden="true"></span>
      </li>
    ))}
  </ol>
</section>

<style is:global>
@layer sections {
#capabilities { position: relative; padding: calc(var(--space-2) * 0.6) var(--space-1) var(--space-2); background: var(--color-1); color: var(--color-2); }
#capabilities .capabilities__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 20px 40px; margin-bottom: clamp(40px, 7vh, 80px); }
#capabilities .capabilities__lead { max-width: 27rem; color: var(--color-5); }
#capabilities .capabilities__deck { display: grid; gap: 20px; }
#capabilities .service { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; padding: clamp(18px, 2.4vw, 34px); overflow: hidden; box-shadow: var(--shadow-1); }
#capabilities .service__text { display: flex; flex-direction: column; gap: 16px; }
#capabilities .service__line { max-width: 30rem; color: var(--color-6); }
#capabilities .service__tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 8px; color: var(--color-6); }
#capabilities .service__media { overflow: hidden; border-radius: var(--radius-3); aspect-ratio: 16 / 10; }
#capabilities .service__media img { width: 100%; height: 100%; object-fit: cover; }
#capabilities .service__shade { position: absolute; inset: 0; background: var(--color-1); opacity: 0; pointer-events: none; }
@media (min-width: 900px) {
  #capabilities .service { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(24px, 3vw, 48px); height: min(62svh, 560px); min-height: 400px; }
  #capabilities .service__media { aspect-ratio: auto; height: 100%; }
}
}
@layer scenes {
@media (prefers-reduced-motion: no-preference) {
  #capabilities.is-deck .service { position: sticky; top: calc(clamp(80px, 12svh, 108px) + var(--i) * 14px); transform-origin: 50% 0; }
}
}
</style>

<script>
import { gsap, scene } from '../scripts/motion.js';

// The cards stack as you scroll; each one shrinks and dims as the next slides over it.
scene('capabilities', () => {
  const section = document.getElementById('capabilities')!;
  const cards = [...section.querySelectorAll<HTMLElement>('.service')];
  section.classList.add('is-deck');
  cards.forEach((card, index) => card.style.setProperty('--i', String(index)));
  cards.slice(0, -1).forEach((card, index) => {
    const next = cards[index + 1];
    gsap.timeline({ defaults: { ease: 'none' }, scrollTrigger: { trigger: next, start: 'top bottom', end: () => `top ${parseFloat(getComputedStyle(next).top) || 0}px`, scrub: true, invalidateOnRefresh: true } })
      .to(card, { scale: 0.9 }, 0)
      .to(card.querySelector('.service__shade'), { opacity: 0.55 }, 0);
  });
  return () => { section.classList.remove('is-deck'); cards.forEach(card => card.style.removeProperty('--i')); };
});
</script>
